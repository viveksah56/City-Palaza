{
  "name": "citypalaza",
  "version": "1.0.0",
  "private": true,
  "description": "Inventory, sales, and role-based staff management for CityPalaza's mobile and electronics store",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:prod": "node --env-file=.env.prod node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "PRISMA_ENV_FILE=.env prisma db push",
    "db:migrate:local": "PRISMA_ENV_FILE=.env prisma migrate dev",
    "db:migrate:prod": "PRISMA_ENV_FILE=.env.prod NODE_ENV=production prisma migrate deploy",
    "db:constraints": "PRISMA_ENV_FILE=.env tsx scripts/apply-constraints.ts",
    "db:constraints:prod": "PRISMA_ENV_FILE=.env.prod NODE_ENV=production tsx scripts/apply-constraints.ts",
    "db:seed": "SEED_ENV_FILE=.env tsx prisma/seed.ts",
    "db:seed:users": "SEED_ENV_FILE=.env node --import tsx prisma/seed-users.ts",
    "db:seed:accounts": "SEED_ENV_FILE=.env node --import tsx prisma/seed-users.ts",
    "db:setup:prod": "npm run db:migrate:prod && npm run db:constraints:prod",
    "db:setup": "npm run db:push && npm run db:constraints && npm run db:seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "@hookform/resolvers": "^5.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-alert-dialog": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.6.1",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.62.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^7.10.1",
    "supabase": "2.121.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "@prisma/client@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.1": true
  }
}
