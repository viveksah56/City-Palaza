{
  "name": "citypalaza",
  "version": "1.0.0",
  "private": true,
  "description": "Stock and sales management system for the CityPalaza mobile & electronics shop",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:prod": "node --env-file=.env.production node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:constraints": "tsx scripts/apply-constraints.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:users": "node --import tsx prisma/seed-users.ts",
    "db:seed:accounts": "node --import tsx prisma/seed-users.ts",
    "db:seed:accounts:prod": "node --env-file=.env.production --import tsx prisma/seed-users.ts",
    "db:setup:prod": "node --env-file=.env.production node_modules/prisma/build/index.js db push && node --env-file=.env.production --import tsx scripts/apply-constraints.ts && npm run db:seed:accounts:prod",
    "db:setup": "prisma db push && tsx scripts/apply-constraints.ts && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "@hookform/resolvers": "^5.2.0",
    "@prisma/client": "^6.16.0",
    "@radix-ui/react-alert-dialog": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.6.1",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.62.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
